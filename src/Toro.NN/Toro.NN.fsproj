<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Toro.NN</PackageId>
    <Version>0.1.0</Version>
    <Authors>ryushiaok</Authors>
    <Description>Neural network building blocks for Toro</Description>
    <PackageTags>fsharp;dotnet;ml;torchsharp;neural-network</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/toro-ml/toro</RepositoryUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://toro-ml.github.io/toro</PackageProjectUrl>
    <FsDocsLicenseLink>https://github.com/toro-ml/toro/blob/main/LICENSE</FsDocsLicenseLink>
    <FsDocsReleaseNotesLink>https://github.com/toro-ml/toro/releases</FsDocsReleaseNotesLink>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Module.fs" />
    <Compile Include="Init.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Layer/Linear.fs" />
    <Compile Include="Layer/Embedding.fs" />
    <Compile Include="Layer/Conv.fs" />
    <Compile Include="Layer/Dropout.fs" />
    <Compile Include="Layer/LayerNorm.fs" />
    <Compile Include="Layer/BatchNorm.fs" />
    <Compile Include="Layer/GroupNorm.fs" />
    <Compile Include="Layer/Activation.fs" />
    <Compile Include="Layer/Pooling.fs" />
    <Compile Include="Block/Sequential.fs" />
    <Compile Include="Block/SequentialT.fs" />
    <Compile Include="Block/Func.fs" />
    <Compile Include="Block/RNN.fs" />
    <Compile Include="Block/KvCache.fs" />
    <Compile Include="Block/Attention.fs" />
    <Compile Include="Loss.fs" />
    <Compile Include="Optim.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Toro/Toro.fsproj" />
  </ItemGroup>

</Project>
