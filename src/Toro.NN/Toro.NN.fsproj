<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Toro.NN</PackageId>
    <Version>0.1.0</Version>
    <Authors>ryushiaok</Authors>
    <Description>Neural network building blocks for Toro</Description>
    <PackageTags>fsharp;dotnet;ml;torchsharp;neural-network</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/toro-ml/toro</RepositoryUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Module.fs" />
    <Compile Include="Init.fs" />
    <Compile Include="VarBuilder.fs" />
    <Compile Include="VarMap.fs" />
    <Compile Include="Linear.fs" />
    <Compile Include="Embedding.fs" />
    <Compile Include="LayerNorm.fs" />
    <Compile Include="Activation.fs" />
    <Compile Include="Sequential.fs" />
    <Compile Include="Loss.fs" />
    <Compile Include="Optim.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Toro/Toro.fsproj" />
  </ItemGroup>

</Project>
