<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Toro.Models</PackageId>
    <Version>0.1.0</Version>
    <Authors>ryushiaok</Authors>
    <Description>Pretrained model implementations for Toro</Description>
    <PackageTags>fsharp;dotnet;ml;torchsharp;models;llm</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/toro-ml/toro</RepositoryUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://toro-ml.github.io/toro</PackageProjectUrl>
    <FsDocsLicenseLink>https://github.com/toro-ml/toro/blob/main/LICENSE</FsDocsLicenseLink>
    <FsDocsReleaseNotesLink>https://github.com/toro-ml/toro/releases</FsDocsReleaseNotesLink>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CausalLm.fs" />
    <Compile Include="Sampling.fs" />
    <Compile Include="Generation.fs" />
    <Compile Include="Internals/JsonConfig.fs" />
    <Compile Include="Internals/LocalModelAssets.fs" />
    <Compile Include="Internals/TensorOwner.fs" />
    <Compile Include="Internals/FixedKvCache.fs" />
    <Compile Include="Internals/CausalInput.fs" />
    <Compile Include="SmolLm2/Types.fs" />
    <Compile Include="SmolLm2/Cache.fs" />
    <Compile Include="SmolLm2/Checkpoint.fs" />
    <Compile Include="SmolLm2/Model.fs" />
    <Compile Include="DistilGpt2/Types.fs" />
    <Compile Include="DistilGpt2/Cache.fs" />
    <Compile Include="DistilGpt2/Checkpoint.fs" />
    <Compile Include="DistilGpt2/Model.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Toro/Toro.fsproj" />
    <ProjectReference Include="../Toro.NN/Toro.NN.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
